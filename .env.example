# Environment Configuration Template for Professor's Vet & Pet Care
# Set DEBUG=False for production hosting

SECRET_KEY=generate-a-secure-random-key-here
DEBUG=False
ALLOWED_HOSTS=*,your-app-name.onrender.com,your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com,https://your-app.up.railway.app

# Optional: PostgreSQL Database URL (Render / Railway / Supabase)
# Leave blank to use SQLite
DATABASE_URL=sqlite:///db.sqlite3
